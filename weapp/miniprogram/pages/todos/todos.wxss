.tabs {
  border: 4rpx solid #171717;
  box-shadow: 6rpx 6rpx 0 #171717;
  display: flex;
  background: var(--surface);
  border-radius: 16rpx;
  padding: 6rpx;
  margin-bottom: 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 27rpx;
  color: var(--text-2);
  border-radius: 12rpx;
}

.tab.on {
  background: var(--primary-w);
  color: var(--primary);
  font-weight: 600;
}

.todo { padding: 24rpx 26rpx; }

.todo-head { display: flex; gap: 18rpx; }

.body { flex: 1; min-width: 0; }

.box {
  flex: none;
  width: 42rpx;
  height: 42rpx;
  border: 3rpx solid var(--border);
  border-radius: 10rpx;
  margin-top: 4rpx;
  color: #fff;
  font-size: 28rpx;
  line-height: 42rpx;
  text-align: center;
}

.box.on {
  background: var(--green);
  border-color: var(--green);
}

.todo-title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}

.is-done .todo-title {
  color: var(--text-3);
  text-decoration: line-through;
  font-weight: 400;
}

.todo-meta {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: var(--text-2);
}

.todo-meta .sep { padding: 0 10rpx; color: var(--text-3); }

.due { font-weight: 600; }
.tone-red { color: var(--red); }
.tone-orange { color: var(--orange); }
.tone-yellow { color: var(--yellow); }

.link { margin-top: 8rpx; color: var(--primary); }
