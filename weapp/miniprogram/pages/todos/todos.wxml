<view class="wrap">

  <view wx:if="{{needEnv}}" class="card">
    <view class="card-title">还差最后一步</view>
    <view class="hint">去 miniprogram/config.js 填上云开发环境 ID 就能用了。</view>
  </view>

  <block wx:if="{{ready}}">
    <view class="tabs">
      <view class="tab {{tab === 'open' ? 'on' : ''}}" bindtap="switchTab" data-tab="open">
        未完成 {{openCount}}
      </view>
      <view class="tab {{tab === 'done' ? 'on' : ''}}" bindtap="switchTab" data-tab="done">
        已完成 {{doneCount}}
      </view>
    </view>

    <view class="card todo {{t.done ? 'is-done' : ''}}" wx:for="{{list}}" wx:key="id" wx:for-item="t">
      <view class="todo-head">
        <view class="box {{t.done ? 'on' : ''}}" bindtap="onToggle" data-docid="{{t._id}}" data-done="{{t.done}}">
          <text wx:if="{{t.done}}">✓</text>
        </view>
        <view class="body">
          <view class="todo-title">{{t.title}}</view>
          <view class="todo-meta">
            <text class="due tone-{{t.dueTone}}">{{t.dueText}}</text>
            <text wx:if="{{t.course}}" class="sep">·</text>
            <text wx:if="{{t.course}}">{{t.course}}</text>
            <text wx:if="{{t.platform}}" class="sep">·</text>
            <text wx:if="{{t.platform}}">{{t.platform}}</text>
          </view>
          <view class="hint">同步于 {{t.ingestText}}</view>
          <view wx:if="{{t.url}}" class="hint link" bindtap="onOpenUrl" data-url="{{t.url}}">复制原链接</view>
        </view>
      </view>
    </view>

    <view wx:if="{{!list.length && !loading}}" class="empty">
      <view class="empty-title">{{tab === 'open' ? '没有未完成的待办' : '还没有完成过任何待办'}}</view>
    </view>
  </block>
</view>
