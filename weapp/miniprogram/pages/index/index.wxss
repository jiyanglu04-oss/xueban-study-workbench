.status { padding-bottom: 22rpx; }

.entry { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }

.entry-b { flex: 1; min-width: 0; }

.entry-t { font-size: 30rpx; font-weight: 600; margin-bottom: 4rpx; }

.arrow { flex: none; font-size: 40rpx; color: var(--text-3); line-height: 1; }

.big-num {
  font-size: 60rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--primary);
}

.right-col { text-align: right; }

.warn-text { color: var(--orange); }

.alert-card {
  border: 2rpx solid var(--orange);
  background: var(--orange-w);
}

.mt { margin-top: 20rpx; }

.group-label {
  font-size: 25rpx;
  color: var(--text-3);
  padding: 10rpx 8rpx;
  font-weight: 600;
}

.group-label.tone-red { color: var(--red); }
.group-label.tone-orange { color: var(--orange); }

.todo { padding: 24rpx 26rpx; }

.todo-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.todo-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
}

.tick {
  flex: none;
  font-size: 23rpx;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

.todo-meta {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: var(--text-2);
}

.todo-meta .sep { padding: 0 10rpx; color: var(--text-3); }

.due { font-weight: 600; }

.tone-red { color: var(--red); }
.tone-orange { color: var(--orange); }
.tone-yellow { color: var(--yellow); }

.link {
  margin-top: 12rpx;
  color: var(--primary);
}

.mono {
  font-family: Menlo, Consolas, monospace;
  background: var(--surface-2);
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}
