<view class="wrap">

  <view wx:if="{{needEnv}}" class="card">
    <view class="card-title">还差最后一步</view>
    <view class="hint">去 miniprogram/config.js 填上云开发环境 ID 就能用了。</view>
  </view>

  <block wx:if="{{ready}}">
    <view class="card bar">
      <view>
        <view class="card-title" style="margin:0">新通知 {{unread}} 条</view>
        <view class="hint">来自超星学习通 / 雨课堂等平台</view>
      </view>
      <view class="acts">
        <text class="act" bindtap="toggleFilter">{{onlyUnread ? '看全部' : '只看未读'}}</text>
        <text class="act" bindtap="onMarkAllRead">全部已读</text>
      </view>
    </view>

    <view class="card msg {{m.read ? 'is-read' : ''}}"
          wx:for="{{list}}" wx:key="_id" wx:for-item="m"
          bindtap="onTapItem" data-id="{{m._id}}" data-url="{{m.url}}" data-read="{{m.read}}">
      <view class="msg-head">
        <view class="dot" wx:if="{{!m.read}}"></view>
        <view class="msg-title">{{m.title}}</view>
        <view class="badge k-{{m.kind}}">{{m.kindLabel}}</view>
      </view>
      <view wx:if="{{m.summary}}" class="msg-summary">{{m.summary}}</view>
      <view class="msg-meta">
        <text>{{m.timeText}}</text>
        <text wx:if="{{m.course}}" class="sep">·</text>
        <text wx:if="{{m.course}}">{{m.course}}</text>
      </view>
    </view>

    <view wx:if="{{!list.length && !loading}}" class="empty">
      <view class="empty-title">{{onlyUnread ? '没有未读通知' : '还没有收到通知'}}</view>
      <view>电脑端同步一次，这里的通知就会跟上来。</view>
    </view>
  </block>
</view>
